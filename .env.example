# Copy to .env.local for local development, or set these as Cloudflare
# Pages "Environment variables" (Settings -> Environment variables) for
# production. Never commit a real .env file — .gitignore already excludes
# .env* except this example file.
#
# This project stays fully static (output: "export" in next.config.ts)
# today: there is no server at runtime, so none of the secret-shaped
# variables below are actually read anywhere yet. They're placeholders
# for features gated behind the feature flags in src/lib/feature-flags.ts
# — every flag defaults to disabled/demo mode when its variable is unset,
# and stays that way until a real account/key exists.

# --- Site ---
NEXT_PUBLIC_SITE_URL=

# --- Feature flags (src/lib/feature-flags.ts) — "true" to enable, anything else = off ---
NEXT_PUBLIC_ENABLE_AFFILIATE=false
NEXT_PUBLIC_ENABLE_PREMIUM=false
NEXT_PUBLIC_ENABLE_AI_WRITER=false
NEXT_PUBLIC_ENABLE_AI_ASSISTANT=false
NEXT_PUBLIC_ENABLE_EMAIL=false
NEXT_PUBLIC_ENABLE_ADS=false
NEXT_PUBLIC_ENABLE_AUTO_UPDATE=false
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# --- Not contracted yet — leave blank until a real account exists.  ---
# --- Setting one of these alone does nothing; it also needs the      ---
# --- matching flag above turned on, and (for anything server-side)   ---
# --- the Cloudflare Pages Functions + D1 migration described in      ---
# --- docs/architecture-plan.md, which hasn't happened yet either.    ---

# AI writer / AI trip planner / AI assistant backend (e.g. Anthropic, OpenAI)
AI_API_KEY=
# Payment processor for the Premium AI Trip Planner (list price $9.99,
# configurable once a real admin settings store exists)
PAYMENT_SECRET=
# Transactional/marketing email provider for lead capture (PDF checklist, etc.)
EMAIL_API_KEY=
# Google Search Console API, for the future SEO auto-rewrite pipeline
SEARCH_CONSOLE_API=
# Cloudflare D1 database binding, once Pages Functions + D1 are provisioned
DATABASE_URL=
